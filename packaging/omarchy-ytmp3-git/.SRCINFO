pkgbase = omarchy-ytmp3-git
	pkgdesc = Download YouTube videos and playlists as MP3/MP4 from the Omarchy launcher or CLI (git)
	pkgver = r1.0000000
	pkgrel = 1
	url = https://github.com/diwash-9/omarchy-ytmp3
	install = omarchy-ytmp3.install
	arch = any
	license = MIT
	makedepends = git
	depends = bash
	depends = yt-dlp
	depends = ffmpeg
	optdepends = wl-clipboard: read the copied URL from the clipboard in the launcher
	optdepends = gum: terminal fallback menus when the Omarchy menu helpers are unavailable
	provides = omarchy-ytmp3
	conflicts = omarchy-ytmp3
	options = !strip
	options = !debug
	source = omarchy-ytmp3::git+https://github.com/diwash-9/omarchy-ytmp3.git
	sha256sums = SKIP

pkgname = omarchy-ytmp3-git
