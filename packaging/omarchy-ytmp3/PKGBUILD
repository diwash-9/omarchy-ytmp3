# Maintainer: Diwash <https://github.com/diwash-9>
pkgname=omarchy-ytmp3
pkgver=2.0.0
pkgrel=1
pkgdesc='Download YouTube videos and playlists as MP3/MP4 from the Omarchy launcher or CLI'
arch=('any')
url='https://github.com/diwash-9/omarchy-ytmp3'
license=('MIT')
depends=('bash' 'yt-dlp' 'ffmpeg')
optdepends=(
  'wl-clipboard: read the copied URL from the clipboard in the launcher'
  'gum: terminal fallback menus when the Omarchy menu helpers are unavailable'
)
options=('!strip' '!debug')
install=omarchy-ytmp3.install
# TODO before the first release: tag the repo (v2.0.0), then run `updpkgsums`.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  install -Dm755 "$srcdir/$pkgname-$pkgver/bin/ytmp3" \
    "$pkgdir/usr/bin/ytmp3"
  install -Dm755 "$srcdir/$pkgname-$pkgver/bin/ytmp3-prompt" \
    "$pkgdir/usr/bin/ytmp3-prompt"
  install -Dm644 "$srcdir/$pkgname-$pkgver/lib/common.sh" \
    "$pkgdir/usr/lib/omarchy-ytmp3/common.sh"
  install -Dm644 "$srcdir/$pkgname-$pkgver/desktop/omarchy-ytmp3.desktop" \
    "$pkgdir/usr/share/applications/omarchy-ytmp3.desktop"
  install -Dm644 "$srcdir/$pkgname-$pkgver/icons/omarchy-ytmp3.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/omarchy-ytmp3.svg"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 \
      "$srcdir/$pkgname-$pkgver/icons/hicolor/${size}x${size}/apps/omarchy-ytmp3.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/omarchy-ytmp3.png"
  done
  install -Dm644 "$srcdir/$pkgname-$pkgver/README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
